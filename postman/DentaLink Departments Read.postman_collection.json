{
    "info": {
        "name": "DentaLink Departments Read API",
        "_postman_id": "dentalink-departments-read",
        "description": "Collection for lab manager department listing and details. Use the `{{baseUrl}}` and `{{token}}` variables.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "List Departments",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/lab/departments?per_page=15",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "lab",
                        "departments"
                    ],
                    "query": [
                        {
                            "key": "per_page",
                            "value": "15"
                        }
                    ]
                },
                "description": "Returns paginated departments for the authenticated lab manager's lab."
            },
            "response": []
        },
        {
            "name": "Show Department",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/lab/departments/{{department_id}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "lab",
                        "departments",
                        "{{department_id}}"
                    ]
                },
                "description": "Returns details for a single department for the authenticated lab manager's lab."
            },
            "response": []
        }
    ],
    "event": [],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "department_id",
            "value": "",
            "type": "string"
        }
    ]
}