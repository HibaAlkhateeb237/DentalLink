{
    "info": {
        "name": "DentaLink Receptionist Orders API",
        "_postman_id": "dentalink-receptionist-orders",
        "description": "Collection for receptionist order management endpoints. Use the `{{baseUrl}}` and `{{token}}` variables.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Get Orders",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/orders",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "orders"
                    ],
                    "query": [
                        {
                            "key": "per_page",
                            "value": "15"
                        },
                        {
                            "key": "status",
                            "value": "pending"
                        },
                        {
                            "key": "priority",
                            "value": "urgent"
                        },
                        {
                            "key": "doctor_id",
                            "value": ""
                        },
                        {
                            "key": "lab_id",
                            "value": ""
                        },
                        {
                            "key": "search",
                            "value": ""
                        },
                        {
                            "key": "from_date",
                            "value": ""
                        },
                        {
                            "key": "to_date",
                            "value": ""
                        },
                        {
                            "key": "sort_by",
                            "value": "created_at"
                        },
                        {
                            "key": "sort_direction",
                            "value": "desc"
                        },
                        {
                            "key": "requires_resubmission",
                            "value": ""
                        }
                    ]
                },
                "description": "Returns paginated receptionist-visible orders. Optional query params: `per_page`, `status`, `priority`, `doctor_id`, `lab_id`, `search`, `from_date`, `to_date`, `sort_by`, `sort_direction`, `requires_resubmission`."
            },
            "response": []
        },
        {
            "name": "Get Order Details",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/orders/{{order_id}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "orders",
                        "{{order_id}}"
                    ]
                },
                "description": "Returns full details for a single order, including doctor, lab, teeth, files, tasks, and payments."
            },
            "response": []
        },
        {
            "name": "Mark Order For Resubmission",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"reason\": \"Impression quality is insufficient; please resubmit with clearer margins.\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/orders/{{order_id}}/resubmission",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "orders",
                        "{{order_id}}",
                        "resubmission"
                    ]
                },
                "description": "Marks an order for doctor resubmission. This only stores the internal resubmission flag and reason; notifications are not sent yet."
            },
            "response": []
        }
    ],
    "event": [],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "order_id",
            "value": "",
            "type": "string"
        }
    ]
}