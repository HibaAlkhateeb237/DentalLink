{
    "info": {
        "name": "DentaLink Labs - Active/Inactive",
        "_postman_id": "dentalink-labs-active-inactive",
        "description": "Collection for lab listing endpoints (active and inactive). Use the `{{baseUrl}}` and `{{token}}` variables.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Get Active Labs",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/labs",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "labs"
                    ]
                },
                "description": "Returns paginated list of active labs. Query params: `per_page` (optional)."
            },
            "response": []
        },
        {
            "name": "Get Inactive Labs",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "X-Locale",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/labs/inactive",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "labs",
                        "inactive"
                    ]
                },
                "description": "Returns paginated list of inactive labs. Query params: `per_page` (optional)."
            },
            "response": []
        }
    ],
    "event": [],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ]
}